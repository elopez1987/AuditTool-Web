<?php

namespace App\Http\Requests\Web\{{Module}}\{{SubModule}};

use Illuminate\Foundation\Http\FormRequest;

/**
 * Filters sent by the DataTable AJAX call. Authorization is handled by the
 * policy in the controller, so authorize() always returns true here.
 */
class Index{{Model}}Request extends FormRequest
{
    public function authorize(): bool
    {
        return true;
    }

    /**
     * @return array<string, string>
     */
    public function rules(): array
    {
        return [
            'name' => 'nullable|string|max:100',
        ];
    }
}
