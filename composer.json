{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-zip": "*",
        "auth0/login": "^7.8",
        "barryvdh/laravel-dompdf": "^3.0",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^2.7",
        "laravel/framework": "^12.0",
        "laravel/passport": "^13.0",
        "laravel/tinker": "^v2.9",
        "laravel/ui": "^4.4",
        "maatwebsite/excel": "^3.1",
        "milon/barcode": "^12.0",
        "pion/laravel-chunk-upload": "^1.5",
        "rap2hpoutre/laravel-log-viewer": "^2.0",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-permission": "^6.2.0",
        "yajra/laravel-datatables-oracle": "^12.0"
    },
    "require-dev": {
        "laravel/boost": "^1.2",
        "laravel/pint": "^1.25",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "nunomaduro/phpinsights": "^2.13",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
      "files": [
        "app/Helpers/UiHelper.php"
      ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "app/vendor/_laravel_idea/"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "format": [
            "./vendor/bin/pint"
        ],
        "format-test": [
            "./vendor/bin/pint --test"
        ],
        "format-diff": [
            "./vendor/bin/pint --test --diff"
        ],
        "format-verbose": [
            "./vendor/bin/pint -v"
        ],
        "format-app": [
            "./vendor/bin/pint app/"
        ],
        "format-config": [
            "./vendor/bin/pint config/"
        ],
        "format-specific": [
            "echo 'Usage: composer run format-specific -- path/to/file.php'"
        ],
        "pint": [
            "./vendor/bin/pint"
        ],
        "install-hooks": [
            "@install-pre-commit-hook"
        ],
        "install-pre-commit-hook": [
            "./install-git-hooks.sh"
        ]
    }
}
